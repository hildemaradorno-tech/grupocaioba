# ── Supabase Admin (service role — NUNCA expor no frontend) ──────────────────
# Obtenha em: Supabase Dashboard → Settings → API → service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Servidor ─────────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-here
PORT=3001

# ── Azure Active Directory (App Registration) ────────────────────────────────
# Registre o app em: https://portal.azure.com → Azure Active Directory → App registrations
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=sua-chave-secreta-gerada-no-azure

# ── SharePoint ────────────────────────────────────────────────────────────────
# Como obter o SITE_ID: GET https://graph.microsoft.com/v1.0/sites/{hostname}:/{site-path}
# Exemplo: graph.microsoft.com/v1.0/sites/caioba.sharepoint.com:/sites/KPIs
SHAREPOINT_SITE_ID=caioba.sharepoint.com,xxxxxxxx-xxxx,xxxxxxxx-xxxx

# Como obter o FILE_ID: GET /sites/{site-id}/drive/root:/pasta/arquivo.xlsx
# Ou copie o link do arquivo no SharePoint e extraia o ID da URL
SHAREPOINT_FILE_ID=01XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Nomes das abas no Excel (deixe em branco para usar os defaults) ───────────
# KPI_SHEET_RESULTADOS=RESULTADOS
# KPI_SHEET_BLOCO1=BLOCO 1
# KPI_SHEET_BLOCO2=BLOCO 2
# KPI_SHEET_BLOCO3_PV=BLOCO 3 - PÓS VENDA
# KPI_SHEET_BLOCO3_PECAS=BLOCO 3 - PEÇAS
# KPI_SHEET_BACKLOG=ORÇAMENTO BACKLOG

# ── Cache ─────────────────────────────────────────────────────────────────────
# Tempo em minutos para manter dados em cache (default: 10)
KPI_CACHE_TTL_MIN=10
